{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "vaultik",
  "version-string": "0.10.1",
  "description": "Lightweight deduplicating, compressing, encrypted backup tool for Windows and Linux",
  "builtin-baseline": "ec48c11eae9448c8c6e7739d93e06fa2433aa95f",
  "dependencies": [
    "zstd",
    "blake3",
    "doctest",
    "nlohmann-json",
    {
      "name": "libssh2",
      "default-features": false,
      "platform": "windows"
    },
    {
      "name": "openssl",
      "platform": "linux"
    },
    {
      "name": "curl",
      "default-features": false,
      "features": [
        "openssl"
      ],
      "platform": "linux"
    }
  ],
  "features": {
    "gui": {
      "description": "Qt 6 Widgets frontend (on Linux the system Qt is used instead)",
      "dependencies": [
        {
          "name": "qtbase",
          "default-features": false,
          "features": [
            "gui",
            "widgets",
            "png"
          ],
          "platform": "windows"
        },
        {
          "name": "qtsvg",
          "default-features": false,
          "platform": "windows"
        }
      ]
    }
  }
}
