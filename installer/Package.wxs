<!-- Vaultik's installer: the three programs in the folder the user picks (C:\Program Files\Vaultik
     by default, shown in full on the folder page), a Start menu entry, and that folder on PATH so
     "vaultik" works in any terminal. The folder is made administrator-only wherever it is: jobs
     with administrator rights and "Start Vaultik as administrator" require that. So it must be a
     folder of Vaultik's own: a drive, Program Files, Windows or ProgramData itself is refused
     rather than locked down. The folder is remembered, so a newer version replaces an older one
     in the same place. -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="Vaultik" Manufacturer="Vaultik" Version="$(var.Version)" Scope="perMachine"
           UpgradeCode="7F3C2B1E-5A4D-4C8E-9B21-6D0E8F4A3C57" Compressed="yes">
    <SummaryInformation Description="Vaultik: encrypted, versioned backups" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of Vaultik is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="VaultikIcon" SourceFile="$(var.IconFile)" />
    <Property Id="ARPPRODUCTICON" Value="VaultikIcon" />

    <!-- The usual pages: welcome, license, where to install (changeable), install. The box
         holds the full path of the folder (see the wording in Package.wxl). -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtf)" />

    <!-- Where an earlier version was installed, so an upgrade goes to the same place: InstallDir
         is the folder itself; versions up to 0.8.0 kept InstallRoot, the folder that got a Vaultik
         folder inside it. -->
    <Property Id="PREVIOUSDIR">
      <RegistrySearch Id="PreviousDir" Root="HKLM" Key="Software\Vaultik" Name="InstallDir" Type="directory" />
    </Property>
    <Property Id="PREVIOUSROOT">
      <RegistrySearch Id="PreviousRoot" Root="HKLM" Key="Software\Vaultik" Name="InstallRoot" Type="directory" />
    </Property>
    <SetProperty Id="INSTALLFOLDER" Action="InstallFolderFromRoot" Value="[PREVIOUSROOT]Vaultik\" After="AppSearch"
                 Sequence="both" Condition="PREVIOUSROOT AND NOT PREVIOUSDIR" />
    <SetProperty Id="INSTALLFOLDER" Action="InstallFolderFromDir" Value="[PREVIOUSDIR]" After="InstallFolderFromRoot"
                 Sequence="both" Condition="PREVIOUSDIR" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Vaultik" />
    </StandardDirectory>
    <Component Id="RememberRoot" Directory="INSTALLFOLDER" Guid="6C3D8E15-2A4B-4F70-9D2E-81B5C7A40F26">
      <RegistryValue Root="HKLM" Key="Software\Vaultik" Name="InstallDir" Type="string" Value="[INSTALLFOLDER]"
                     KeyPath="yes" />
    </Component>

    <!-- The folder is made administrator-only, so it must be Vaultik's own: never a drive or a
         folder Windows needs others to write to. Checked after the folder page, before anything
         is written; also for a silent install with INSTALLFOLDER on the command line. In five parts:
         a condition holds at most 255 characters. -->
    <CustomAction Id="RefuseDrive1" Error="Vaultik cannot be installed directly in [INSTALLFOLDER]: that folder would be made administrator-only. Choose a folder of its own, such as [ProgramFiles64Folder]Vaultik." />
    <CustomAction Id="RefuseDrive2" Error="Vaultik cannot be installed directly in [INSTALLFOLDER]: that folder would be made administrator-only. Choose a folder of its own, such as [ProgramFiles64Folder]Vaultik." />
    <CustomAction Id="RefuseDrive3" Error="Vaultik cannot be installed directly in [INSTALLFOLDER]: that folder would be made administrator-only. Choose a folder of its own, such as [ProgramFiles64Folder]Vaultik." />
    <CustomAction Id="RefuseSystem1" Error="Vaultik cannot be installed directly in [INSTALLFOLDER]: that folder would be made administrator-only. Choose a folder of its own, such as [ProgramFiles64Folder]Vaultik." />
    <CustomAction Id="RefuseSystem2" Error="Vaultik cannot be installed directly in [INSTALLFOLDER]: that folder would be made administrator-only. Choose a folder of its own, such as [ProgramFiles64Folder]Vaultik." />
    <StandardDirectory Id="ProgramMenuFolder">
      <!-- For all users; a machine-wide value marks it installed. -->
      <Component Id="StartMenuShortcut" Guid="9B4E1C27-6F03-4A8D-B5E2-7C19D0A36F84">
        <Shortcut Id="StartMenuShortcut" Name="Vaultik" Description="Back up your files and restore them"
                  Target="[INSTALLFOLDER]vaultik-gui.exe" WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKMU" Key="Software\Vaultik" Name="StartMenuShortcut" Type="integer" Value="1"
                       KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <ComponentGroup Id="Programs" Directory="INSTALLFOLDER">
      <Component>
        <File Source="$(var.BinDir)\vaultik.exe" KeyPath="yes" />
      </Component>
      <Component>
        <File Source="$(var.BinDir)\vaultik-gui.exe" KeyPath="yes" />
      </Component>
      <Component>
        <File Id="VaultikTaskExe" Source="$(var.BinDir)\vaultik-task.exe" KeyPath="yes" />
      </Component>
      <Component Id="PathEntry" Guid="3D1B6E42-8C7A-4F15-A0D9-52E7C4B19F63">
        <Environment Id="PathEntry" Name="PATH" Value="[INSTALLFOLDER]" Action="set" Part="last"
                     System="yes" Permanent="no" />
        <!-- Administrators and SYSTEM may change the folder, everyone else only run the programs,
             also outside Program Files (a folder on another drive would otherwise inherit that
             any user may change it). Protected: the parent's permissions do not flow in. Owned by
             Administrators, so a user who made the folder before cannot change its permissions. -->
        <CreateFolder>
          <PermissionEx Sddl="O:BAG:SYD:PAI(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)(A;OICI;0x1200a9;;;BU)" />
        </CreateFolder>
      </Component>
    </ComponentGroup>

    <!-- "Earlier versions in Vaultik" in File Explorer's right-click menu, for files and folders: it
         opens the item's history in the job that backs it up. -->
    <Component Id="ExplorerMenu" Directory="INSTALLFOLDER" Guid="5E2A9C14-3B7D-4E60-8F1A-C4D2B97E0A35">
      <RegistryKey Root="HKLM" Key="Software\Classes\*\shell\Vaultik.History">
        <RegistryValue Name="MUIVerb" Type="string" Value="Earlier versions in Vaultik" KeyPath="yes" />
        <RegistryValue Name="Icon" Type="string" Value="[INSTALLFOLDER]vaultik-gui.exe" />
        <RegistryKey Key="command">
          <RegistryValue Type="string" Value="&quot;[INSTALLFOLDER]vaultik-gui.exe&quot; --history &quot;%1&quot;" />
        </RegistryKey>
      </RegistryKey>
      <RegistryKey Root="HKLM" Key="Software\Classes\Directory\shell\Vaultik.History">
        <RegistryValue Name="MUIVerb" Type="string" Value="Earlier versions in Vaultik" />
        <RegistryValue Name="Icon" Type="string" Value="[INSTALLFOLDER]vaultik-gui.exe" />
        <RegistryKey Key="command">
          <RegistryValue Type="string" Value="&quot;[INSTALLFOLDER]vaultik-gui.exe&quot; --history &quot;%1&quot;" />
        </RegistryKey>
      </RegistryKey>
    </Component>

    <!-- The Event Log source of Vaultik's entries (every run's result, see README). EventCreate.exe
         holds messages 1 to 1000 that show the entry's own text, so no message file of our own. -->
    <Component Id="EventSource" Directory="INSTALLFOLDER" Guid="8A4C2E61-5D3B-4F97-B1E8-26C9D7A03F52">
      <RegistryKey Root="HKLM" Key="SYSTEM\CurrentControlSet\Services\EventLog\Application\Vaultik">
        <RegistryValue Name="EventMessageFile" Type="expandable" Value="%SystemRoot%\System32\EventCreate.exe"
                       KeyPath="yes" />
        <RegistryValue Name="TypesSupported" Type="integer" Value="7" />
      </RegistryKey>
    </Component>

    <!-- Removing Vaultik (not upgrading it) also removes its scheduled tasks, every account's, as
         they would only fail without the programs. Jobs, history and backups stay. -->
    <CustomAction Id="RemoveScheduledTasks" FileRef="VaultikTaskExe" ExeCommand="uninstall-cleanup"
                  Execute="deferred" Impersonate="no" Return="ignore" />
    <InstallExecuteSequence>
      <Custom Action="RefuseDrive1" After="CostFinalize" Condition="NOT REMOVE AND (INSTALLFOLDER~=&quot;A:\&quot; OR INSTALLFOLDER~=&quot;B:\&quot; OR INSTALLFOLDER~=&quot;C:\&quot; OR INSTALLFOLDER~=&quot;D:\&quot; OR INSTALLFOLDER~=&quot;E:\&quot; OR INSTALLFOLDER~=&quot;F:\&quot; OR INSTALLFOLDER~=&quot;G:\&quot; OR INSTALLFOLDER~=&quot;H:\&quot; OR INSTALLFOLDER~=&quot;I:\&quot;)" />
      <Custom Action="RefuseDrive2" After="CostFinalize" Condition="NOT REMOVE AND (INSTALLFOLDER~=&quot;J:\&quot; OR INSTALLFOLDER~=&quot;K:\&quot; OR INSTALLFOLDER~=&quot;L:\&quot; OR INSTALLFOLDER~=&quot;M:\&quot; OR INSTALLFOLDER~=&quot;N:\&quot; OR INSTALLFOLDER~=&quot;O:\&quot; OR INSTALLFOLDER~=&quot;P:\&quot; OR INSTALLFOLDER~=&quot;Q:\&quot; OR INSTALLFOLDER~=&quot;R:\&quot;)" />
      <Custom Action="RefuseDrive3" After="CostFinalize" Condition="NOT REMOVE AND (INSTALLFOLDER~=&quot;S:\&quot; OR INSTALLFOLDER~=&quot;T:\&quot; OR INSTALLFOLDER~=&quot;U:\&quot; OR INSTALLFOLDER~=&quot;V:\&quot; OR INSTALLFOLDER~=&quot;W:\&quot; OR INSTALLFOLDER~=&quot;X:\&quot; OR INSTALLFOLDER~=&quot;Y:\&quot; OR INSTALLFOLDER~=&quot;Z:\&quot;)" />
      <Custom Action="RefuseSystem1" After="CostFinalize" Condition="NOT REMOVE AND (INSTALLFOLDER~=ProgramFiles64Folder OR INSTALLFOLDER~=ProgramFilesFolder OR INSTALLFOLDER~=CommonFiles64Folder OR INSTALLFOLDER~=CommonFilesFolder)" />
      <Custom Action="RefuseSystem2" After="CostFinalize" Condition="NOT REMOVE AND (INSTALLFOLDER~=WindowsFolder OR INSTALLFOLDER~=System64Folder OR INSTALLFOLDER~=SystemFolder OR INSTALLFOLDER~=CommonAppDataFolder)" />
      <Custom Action="RemoveScheduledTasks" Before="RemoveFiles"
              Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>

    <Feature Id="Main" Title="Vaultik">
      <ComponentGroupRef Id="Programs" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="ExplorerMenu" />
      <ComponentRef Id="EventSource" />
      <ComponentRef Id="RememberRoot" />
    </Feature>
  </Package>
</Wix>
