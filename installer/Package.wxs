<!-- Vaultik's installer: the three programs in a folder named Vaultik inside the folder the user
     picks (Program Files by default), a Start menu entry, and that folder on PATH so "vaultik"
     works in any terminal. The Vaultik folder (never the one picked, which may be a drive or
     Program Files itself) is made administrator-only wherever it is: jobs with administrator
     rights and "Start Vaultik as administrator" require that. The folder picked is remembered,
     so a newer version replaces an older one in the same place. -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="Vaultik" Manufacturer="Vaultik" Version="$(var.Version)" Scope="perMachine"
           UpgradeCode="7F3C2B1E-5A4D-4C8E-9B21-6D0E8F4A3C57" Compressed="yes">
    <SummaryInformation Description="Vaultik: encrypted, versioned backups" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of Vaultik is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="VaultikIcon" SourceFile="$(var.IconFile)" />
    <Property Id="ARPPRODUCTICON" Value="VaultikIcon" />

    <!-- The usual pages: welcome, license, where to install (changeable), install. The folder
         picked is the one that gets a Vaultik folder (see the wording in Package.wxl). -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLROOT" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtf)" />

    <!-- Where an earlier version was installed, so an upgrade goes to the same place. -->
    <Property Id="INSTALLROOT">
      <RegistrySearch Id="PreviousRoot" Root="HKLM" Key="Software\Vaultik" Name="InstallRoot" Type="directory" />
    </Property>

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLROOT" Name=".">
        <Directory Id="INSTALLFOLDER" Name="Vaultik" />
      </Directory>
    </StandardDirectory>
    <Component Id="RememberRoot" Directory="INSTALLFOLDER" Guid="6C3D8E15-2A4B-4F70-9D2E-81B5C7A40F26">
      <RegistryValue Root="HKLM" Key="Software\Vaultik" Name="InstallRoot" Type="string" Value="[INSTALLROOT]"
                     KeyPath="yes" />
    </Component>
    <StandardDirectory Id="ProgramMenuFolder">
      <!-- For all users; a machine-wide value marks it installed. -->
      <Component Id="StartMenuShortcut" Guid="9B4E1C27-6F03-4A8D-B5E2-7C19D0A36F84">
        <Shortcut Id="StartMenuShortcut" Name="Vaultik" Description="Back up your files and restore them"
                  Target="[INSTALLFOLDER]vaultik-gui.exe" WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKMU" Key="Software\Vaultik" Name="StartMenuShortcut" Type="integer" Value="1"
                       KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <ComponentGroup Id="Programs" Directory="INSTALLFOLDER">
      <Component>
        <File Source="$(var.BinDir)\vaultik.exe" KeyPath="yes" />
      </Component>
      <Component>
        <File Source="$(var.BinDir)\vaultik-gui.exe" KeyPath="yes" />
      </Component>
      <Component>
        <File Id="VaultikTaskExe" Source="$(var.BinDir)\vaultik-task.exe" KeyPath="yes" />
      </Component>
      <Component Id="PathEntry" Guid="3D1B6E42-8C7A-4F15-A0D9-52E7C4B19F63">
        <Environment Id="PathEntry" Name="PATH" Value="[INSTALLFOLDER]" Action="set" Part="last"
                     System="yes" Permanent="no" />
        <!-- Administrators and SYSTEM may change the folder, everyone else only run the programs,
             also outside Program Files (a folder on another drive would otherwise inherit that
             any user may change it). Protected: the parent's permissions do not flow in. -->
        <CreateFolder>
          <PermissionEx Sddl="D:PAI(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)(A;OICI;0x1200a9;;;BU)" />
        </CreateFolder>
      </Component>
    </ComponentGroup>

    <!-- "Earlier versions in Vaultik" in File Explorer's right-click menu, for files and folders: it
         opens the item's history in the job that backs it up. -->
    <Component Id="ExplorerMenu" Directory="INSTALLFOLDER" Guid="5E2A9C14-3B7D-4E60-8F1A-C4D2B97E0A35">
      <RegistryKey Root="HKLM" Key="Software\Classes\*\shell\Vaultik.History">
        <RegistryValue Name="MUIVerb" Type="string" Value="Earlier versions in Vaultik" KeyPath="yes" />
        <RegistryValue Name="Icon" Type="string" Value="[INSTALLFOLDER]vaultik-gui.exe" />
        <RegistryKey Key="command">
          <RegistryValue Type="string" Value="&quot;[INSTALLFOLDER]vaultik-gui.exe&quot; --history &quot;%1&quot;" />
        </RegistryKey>
      </RegistryKey>
      <RegistryKey Root="HKLM" Key="Software\Classes\Directory\shell\Vaultik.History">
        <RegistryValue Name="MUIVerb" Type="string" Value="Earlier versions in Vaultik" />
        <RegistryValue Name="Icon" Type="string" Value="[INSTALLFOLDER]vaultik-gui.exe" />
        <RegistryKey Key="command">
          <RegistryValue Type="string" Value="&quot;[INSTALLFOLDER]vaultik-gui.exe&quot; --history &quot;%1&quot;" />
        </RegistryKey>
      </RegistryKey>
    </Component>

    <!-- Removing Vaultik (not upgrading it) also removes its scheduled tasks, every account's, as
         they would only fail without the programs. Jobs, history and backups stay. -->
    <CustomAction Id="RemoveScheduledTasks" FileRef="VaultikTaskExe" ExeCommand="uninstall-cleanup"
                  Execute="deferred" Impersonate="no" Return="ignore" />
    <InstallExecuteSequence>
      <Custom Action="RemoveScheduledTasks" Before="RemoveFiles"
              Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>

    <Feature Id="Main" Title="Vaultik">
      <ComponentGroupRef Id="Programs" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="ExplorerMenu" />
      <ComponentRef Id="RememberRoot" />
    </Feature>
  </Package>
</Wix>
