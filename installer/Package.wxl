<!-- Wording of the installer's folder page: the box holds the full path of Vaultik's own folder,
     which is made administrator-only (so a drive or Program Files itself is refused). -->
<WixLocalization Culture="en-US" xmlns="http://wixtoolset.org/schemas/v4/wxl">
  <String Id="InstallDirDlgTitle" Value="{\WixUI_Font_Title}Where to install" />
  <String Id="InstallDirDlgDescription" Value="Vaultik is installed in this folder, which only administrators can change." />
  <String Id="InstallDirDlgFolderLabel" Value="Install Vaultik in:" />
</WixLocalization>
